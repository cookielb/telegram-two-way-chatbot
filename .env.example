# Telegram Bot配置
BOT_TOKEN=your_bot_token_here
FORUM_GROUP_ID=-1001234567890

# 管理员ID（逗号分隔）
ADMIN_IDS=123456789,987654321

# Gemini API配置
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=
ENABLE_AI_FILTER=true
AI_CONFIDENCE_THRESHOLD=70

# OpenAI API配置 (可选)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 功能开关
VERIFICATION_ENABLED=true
AUTO_UNBLOCK_ENABLED=false

# 数据库配置
DATABASE_PATH=./data/bot.db

# 消息队列配置
MAX_WORKERS=5
QUEUE_TIMEOUT=30

# 验证配置
VERIFICATION_TIMEOUT=300
MAX_VERIFICATION_ATTEMPTS=3

# 速率限制
MAX_MESSAGES_PER_MINUTE=30

# 适用于 Watchtower 的 Telegram 通知（可选。若启用，需删除配置的#注释）
#WATCHTOWER_NOTIFICATIONS=shoutrrr
#WATCHTOWER_NOTIFICATION_URL=telegram://token@telegram?chats=channel-1[,chat-id-1,...]

# 优化版广告审查配置
AI_REVIEW_THRESHOLD=40
AI_NEW_USER_REVIEW_THRESHOLD=25
NEW_USER_STRICT_MESSAGES=3
AI_TIMEOUT_SECONDS=20
AI_RETRY_ATTEMPTS=2

# AI 异常继续转发并通知管理员；同一管理员告警间隔（秒）
AI_ALERT_INTERVAL_SECONDS=3600
